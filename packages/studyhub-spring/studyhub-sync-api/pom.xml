<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.studyhub</groupId>
    <artifactId>studyhub-spring</artifactId>
    <version>0.1.1-SNAPSHOT</version>
  </parent>
  <artifactId>studyhub-sync-api</artifactId>
  <properties>
    <!-- Desktop inference, tokenizer and graph libraries never run on the ciphertext relay. -->
    <relay.excludedGroups>org.springframework.ai,com.microsoft.onnxruntime,ai.djl,ai.djl.huggingface,com.github.jelmerk,com.bucket4j,io.github.resilience4j,io.projectreactor.netty,io.netty,org.eclipse.collections,com.knuddels,org.antlr,com.github.victools,io.swagger.core.v3,net.java.dev.jna,org.apache.commons,commons-io,commons-codec,org.jetbrains.kotlin,io.prometheus,io.opentelemetry</relay.excludedGroups>
  </properties>
  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.studyhub</groupId>
      <artifactId>studyhub-domain</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.studyhub</groupId>
      <artifactId>studyhub-storage</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.studyhub</groupId>
      <artifactId>studyhub-platform-shell</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.studyhub</groupId>
      <artifactId>studyhub-ai-engine</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.studyhub</groupId>
      <artifactId>studyhub-retrieval</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-websocket</artifactId>
    </dependency>
    <dependency>
      <groupId>io.studyhub</groupId>
      <artifactId>studyhub-contracts-java</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>relay-classes</id>
            <goals><goal>jar</goal></goals>
            <configuration>
              <classifier>relay</classifier>
              <includes>
                <include>io/studyhub/sync/**</include>
                <include>**/*__*.class</include>
                <include>META-INF/native-image/**</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>3.1.0</version>
        <executions>
          <execution>
            <id>bundle-studyhub-ui</id>
            <phase>generate-resources</phase>
            <goals><goal>run</goal></goals>
            <configuration>
              <target>
                <exec executable="node" failonerror="true">
                  <arg value="${project.basedir}/bundle-ui.mjs"/>
                  <arg value="${project.build.outputDirectory}/static"/>
                </exec>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>io.studyhub.gateway.StudyHubApplication</mainClass>
          <classifier>exec</classifier>
        </configuration>
        <executions>
          <execution>
            <id>ciphertext-relay</id>
            <goals><goal>repackage</goal></goals>
            <configuration>
              <classifier>relay</classifier>
              <mainClass>io.studyhub.sync.SyncServerApplication</mainClass>
              <excludeGroupIds>${relay.excludedGroups}</excludeGroupIds>
              <excludes>
                <exclude><groupId>io.micrometer</groupId><artifactId>micrometer-registry-prometheus</artifactId></exclude>
                <exclude><groupId>io.studyhub</groupId><artifactId>studyhub-retrieval</artifactId></exclude>
                <exclude><groupId>io.studyhub</groupId><artifactId>studyhub-ai-engine</artifactId></exclude>
                <exclude><groupId>io.studyhub</groupId><artifactId>studyhub-platform-shell</artifactId></exclude>
                <exclude><groupId>io.studyhub</groupId><artifactId>studyhub-contracts-java</artifactId></exclude>
              </excludes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>relay-aot</id>
      <build><plugins><plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions><execution>
          <id>relay-aot</id><goals><goal>process-aot</goal></goals>
          <configuration>
            <mainClass>io.studyhub.sync.SyncServerApplication</mainClass>
            <jvmArguments>--enable-preview</jvmArguments>
            <excludes>
              <exclude><groupId>io.micrometer</groupId><artifactId>micrometer-registry-prometheus</artifactId></exclude>
            </excludes>
            <excludeGroupIds>${relay.excludedGroups}</excludeGroupIds>
          </configuration>
        </execution></executions>
      </plugin></plugins></build>
    </profile>
  </profiles>
</project>
