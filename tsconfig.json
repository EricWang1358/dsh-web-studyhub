{
  // Optional type checking, file by file (#749). No migration: the sources stay JavaScript, and a file is checked only when it starts
  // with `// @ts-check` (checkJs is off, so every other file is parsed but never reported). `npm run typecheck` runs this; it is not part
  // of `npm run verify` yet, so a new annotation never blocks the build on its own. Shapes that cross modules live in lib/types.js.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["lib/**/*.js", "ui/**/*.js"],
  // Generated by `npm run build`; never in a checkout, and not a source to check.
  "exclude": ["node_modules", "lib/client.js", "lib/client.*.js"]
}
